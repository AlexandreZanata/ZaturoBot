{
  "name": "procurali-web",
  "version": "0.2.0",
  "private": true,
  "description": "Procurali storefront prototype: Next.js static export with Tailwind CSS and Aceternity UI components.",
  "type": "module",
  "scripts": {
    "prepare-data": "node scripts/prepare.mjs",
    "dev": "node scripts/prepare.mjs && next dev --hostname 127.0.0.1 --port 4173",
    "build": "node scripts/prepare.mjs && next build",
    "serve": "node scripts/serve.mjs",
    "test": "npm run build && node --test test/verify-prototype.test.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.73.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
