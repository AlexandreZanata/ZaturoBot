import { LineEdit, TextEdit, ScrollView, ComboBox, Spinner, CheckBox } from "std-widgets.slint";
export struct FeedRow { id:string, time:string, label:string, text:string, role:string, task:string, artifact:string }
export struct WorkerRow { id:string, detail:string }

component FlatButton inherits FocusScope {
    in property<string> label;
    in property<image> icon;
    in property<bool> primary:false;
    callback clicked;
    min-width:118px; height:40px;
    accessible-role:button; accessible-label:root.label;
    Rectangle {
        border-radius:12px; border-width:root.has-focus ? 2px : 1px;
        border-color:root.has-focus ? #FFFFFF : root.primary && root.enabled ? #D4AC00 : #303036;
        background:!root.enabled ? #252529 : root.primary ? touch.has-hover ? #F1C71F : #E5B900 : touch.has-hover ? #232328 : #17171B;
        HorizontalLayout {padding-left:13px;padding-right:13px;spacing:8px;alignment:center;
            Image {source:root.icon;width:21px;image-fit:contain;colorize:root.primary && root.enabled ? #0B0B0D : root.enabled ? #FFFFFF : #777780;}
            Text {text:root.label;color:root.primary && root.enabled ? #0B0B0D : root.enabled ? #FFFFFF : #777780;font-size:13px;font-weight:600;vertical-alignment:center;}
        }
    }
    touch:=TouchArea {enabled:root.enabled;clicked=>{root.focus();root.clicked();}}
    key-pressed(event)=>{if root.enabled && (event.text==Key.Return || event.text==" "){root.clicked();return accept;}return reject;}
}
component IconButton inherits FocusScope {
    in property<string> label;
    in property<image> icon;
    in property<bool> primary:false;
    callback clicked;
    width:42px;height:42px;
    accessible-role:button;accessible-label:root.label;
    Rectangle {border-radius:12px;border-width:root.has-focus ? 2px : 1px;
        border-color:root.has-focus ? #FFFFFF : root.primary && root.enabled ? #D4AC00 : #303036;
        background:!root.enabled ? #252529 : root.primary ? touch.has-hover ? #F1C71F : #E5B900 : touch.has-hover ? #232328 : #17171B;
        Image {source:root.icon;width:23px;height:23px;x:(parent.width - self.width)/2;y:(parent.height - self.height)/2;image-fit:contain;colorize:root.primary && root.enabled ? #0B0B0D : root.enabled ? #FFFFFF : #777780;}
    }
    touch:=TouchArea {enabled:root.enabled;clicked=>{root.focus();root.clicked();}}
    key-pressed(event)=>{if root.enabled && (event.text==Key.Return || event.text==" "){root.clicked();return accept;}return reject;}
}
component NavItem inherits FocusScope {
    in property<image> icon;
    in property<string> label;
    in property<bool> selected;
    callback clicked;
    height:46px;accessible-role:button;accessible-label:root.label;
    Rectangle {border-radius:13px;border-width:1px;border-color:root.selected ? #D4AC00 : root.has-focus ? #FFFFFF : #303036;
        background:root.selected ? #E5B900 : touch.has-hover ? #222227 : #151519;
        HorizontalLayout {padding-left:14px;padding-right:12px;spacing:11px;
            Image {source:root.icon;width:22px;image-fit:contain;colorize:root.selected ? #0B0B0D : #A6A6B0;}
            Text {text:root.label;vertical-alignment:center;font-size:13px;font-weight:root.selected ? 700 : 500;color:root.selected ? #0B0B0D : #D9D9E0;}
        }
    }
    touch:=TouchArea {clicked=>{root.focus();root.clicked();}}
    key-pressed(event)=>{if event.text==Key.Return || event.text==" " {root.clicked();return accept;}return reject;}
}
component MessageBubble inherits Rectangle {
    in property<FeedRow> item;
    in property<length> bubble-limit;
    in property<image> folder-icon;
    callback open-artifact(string);
    property<bool> owner: item.role=="owner" || item.role=="user";
    width:min(root.bubble-limit,max(168px,natural.preferred-width+32px));
    height:content.preferred-height;
    background:root.owner ? #E5B900 : #17171B;
    border-width:1px;border-color:root.owner ? #D4AC00 : #303036;border-radius:16px;
    natural:=Text {text:root.item.text;font-size:14px;wrap:no-wrap;visible:false;width:0px;height:0px;}
    content:=VerticalLayout {padding:15px;spacing:7px;
        Text {text:root.item.label;font-size:11px;font-weight:650;color:root.owner ? #51440B : #E5B900;wrap:word-wrap;}
        Text {text:root.item.text;font-size:14px;color:root.owner ? #0B0B0D : #FFFFFF;wrap:word-wrap;}
        if root.item.artifact!="": FlatButton {label:"Abrir imagem";icon:root.folder-icon;clicked=>{root.open-artifact(root.item.artifact);}}
        Text {text:root.item.time;font-size:10px;color:root.owner ? #51440B : #A6A6B0;horizontal-alignment:right;}
    }
}
component ChatViewport inherits ScrollView {
    in-out property<length> scroll-position:0px;
    changed scroll-position=>{if root.content-y!=root.scroll-position {root.content-y=root.scroll-position;}}
    changed content-y=>{if root.scroll-position!=root.content-y {root.scroll-position=root.content-y;}}
    in property<[FeedRow]> events;
    in property<bool> has-more;
    in property<image> chat-icon;
    in property<image> folder-icon;
    callback load-more;
    callback open-artifact(string);
    callback metrics(length,length);
    callback user-scrolled;
    horizontal-scrollbar-policy:always-off;
    changed content-height=>{root.metrics(root.content-height,root.visible-height);}
    changed visible-height=>{root.metrics(root.content-height,root.visible-height);}
    scrolled=>{root.user-scrolled();}
    column:=VerticalLayout {width:root.visible-width;padding:18px;spacing:12px;
        if root.has-more: HorizontalLayout {alignment:center;
            FlatButton {label:"Mensagens anteriores";icon:root.chat-icon;clicked=>{root.load-more();}}
        }
        for item in root.events: HorizontalLayout {spacing:0px;
            if item.role=="owner" || item.role=="user": Rectangle {horizontal-stretch:1;}
            MessageBubble {item:item;bubble-limit:min(720px,(root.visible-width - 36px)*0.84);folder-icon:root.folder-icon;open-artifact(id)=>{root.open-artifact(id);}}
            if item.role!="owner" && item.role!="user": Rectangle {horizontal-stretch:1;}
        }
    }
}
export component AppWindow inherits Window {
    title:"ZaturoBot";preferred-width:1280px;preferred-height:850px;min-width:980px;min-height:700px;
    background:#0B0B0D;default-font-family:"Inter";default-font-size:14px;
    in property<image> brand-icon;icon:root.brand-icon;
    in property<image> icon-chat; in property<image> icon-services; in property<image> icon-sync;
    in property<image> icon-settings; in property<image> icon-send; in property<image> icon-filter;
    in property<image> icon-search; in property<image> icon-calendar; in property<image> icon-terminal;
    in property<image> icon-youtube; in property<image> icon-phone; in property<image> icon-shield;
    in property<image> icon-folder; in property<image> icon-check; in property<image> icon-close; in property<image> icon-key;
    in-out property<string> page:"hub";
    in-out property<string> selected-day;
    in-out property<string> search-query;
    in-out property<int> kind-index:0;
    in-out property<string> composer;
    in-out property<string> worker-target:"local-worker";
    in-out property<string> connection-url:"http://127.0.0.1:17878";
    in-out property<string> connection-token;
    in property<string> connection-state:"Conexão não configurada";
    in property<string> status-message:"Conecte seu hub para ver o histórico.";
    in property<bool> online:false;
    in property<bool> busy:false;
    in property<bool> sending:false;
    in property<bool> has-more:false;
    in property<[FeedRow]> events;
    in property<[WorkerRow]> workers;
    in property<string> services-summary:"Conecte o hub para consultar os serviços.";
    in-out property<bool> preview-open:false;
    in property<image> preview-image;
    in-out property<string> private-device:"owner-phone";
    in-out property<string> private-watch:"0";
    in-out property<bool> private-confirmed:false;
    in property<bool> private-running:false;
    in property<image> private-image;
    in property<bool> private-image-visible:false;
    in property<string> private-status:"Visualização privada sem histórico, OCR ou envio à IA.";
    in-out property<length> chat-scroll-y:0px;
    in-out property<length> chat-total-height:0px;
    in-out property<length> chat-visible-height:0px;
    out property<bool> at-bottom: root.chat-total-height+root.chat-scroll-y<=root.chat-visible-height+28px;
    property<bool> follow-tail:true;
    out property<bool> following-tail:root.follow-tail;
    in-out property<int> scroll-mode:0;
    in-out property<int> scroll-revision:0;
    in-out property<length> scroll-base-y;
    in-out property<length> scroll-base-height;
    callback start-private;callback close-private;callback refresh;callback filters-changed;
    callback send-message;callback diagnostic;callback save-connection;callback service-action(string);
    callback load-more;callback open-artifact(string);callback hub-opened;callback settle-scroll;
    public function prepare-scroll(mode:int) {
        root.scroll-base-y=root.chat-scroll-y;
        root.scroll-base-height=root.chat-total-height;
        root.scroll-mode=mode;
        root.follow-tail=mode==1;
        root.scroll-revision=root.scroll-revision>=1000000000 ? 0 : root.scroll-revision+1;
        root.settle-scroll();
    }
    public function scroll-to-bottom() {root.prepare-scroll(1);}
    public function open-hub() {
        if root.page=="hub" {root.scroll-to-bottom();root.hub-opened();}
        else {root.page="hub";}
    }
    changed page=>{if root.page=="hub" {root.scroll-to-bottom();root.hub-opened();}}
    changed chat-scroll-y=>{if root.scroll-mode==0 {root.follow-tail=root.at-bottom;}}
    VerticalLayout {spacing:0px;
        Rectangle {height:70px;background:#0B0B0D;
            HorizontalLayout {padding-left:22px;padding-right:24px;spacing:10px;
                Image {source:root.brand-icon;width:52px;image-fit:contain;}
                HorizontalLayout {spacing:0px;Text{text:"Zaturo";vertical-alignment:center;font-size:25px;font-weight:750;color:#FFFFFF;}Text{text:"Bot";vertical-alignment:center;font-size:25px;font-weight:750;color:#E5B900;}}
                Rectangle {horizontal-stretch:1;}
                Rectangle {width:7px;Rectangle {width:7px;height:7px;y:(parent.height - self.height)/2;border-radius:4px;background:root.online ? #76C799 : #777780;}}
                Text {text:root.connection-state;vertical-alignment:center;color:#A6A6B0;font-size:12px;}
                IconButton {label:"Ajustes";icon:root.icon-settings;clicked=>{root.close-private();root.page="settings";}}
            }
        }
        Rectangle {height:1px;background:#303036;}
        HorizontalLayout {spacing:0px;
            Rectangle {width:210px;background:#101013;
                VerticalLayout {padding:16px;spacing:9px;
                    Text {text:"SEU ESPAÇO";height:27px;font-size:10px;font-weight:650;color:#777780;}
                    NavItem {icon:root.icon-chat;label:"Hub";selected:root.page=="hub";clicked=>{root.close-private();root.open-hub();}}
                    NavItem {icon:root.icon-services;label:"Serviços";selected:root.page=="services";clicked=>{root.close-private();root.page="services";}}
                    NavItem {icon:root.icon-terminal;label:"Computadores";selected:root.page=="workers";clicked=>{root.close-private();root.page="workers";}}
                    NavItem {icon:root.icon-folder;label:"Arquivos";selected:root.page=="files";clicked=>{root.close-private();root.page="files";}}
                    NavItem {icon:root.icon-shield;label:"Tela privada";selected:root.page=="private";clicked=>{root.page="private";}}
                    Rectangle {vertical-stretch:1;}
                    NavItem {icon:root.icon-settings;label:"Ajustes";selected:root.page=="settings";clicked=>{root.close-private();root.page="settings";}}
                    Text {text:"Seu histórico, no seu hub.";height:34px;font-size:11px;color:#777780;wrap:word-wrap;}
                }
            }
            Rectangle {width:1px;background:#303036;}
            Rectangle {horizontal-stretch:1;
                VerticalLayout {padding-left:24px;padding-right:24px;padding-top:18px;padding-bottom:12px;spacing:12px;
                    HorizontalLayout {height:44px;spacing:12px;
                        Text {text:root.page=="hub" ? "Conversas e atividades" : root.page=="services" ? "Serviços" : root.page=="workers" ? "Computadores" : root.page=="files" ? "Arquivos" : root.page=="private" ? "Tela privada" : "Ajustes";font-size:23px;font-weight:700;color:#FFFFFF;vertical-alignment:center;horizontal-stretch:1;}
                        if root.busy: Spinner {width:20px;height:20px;}
                        FlatButton {label:"Atualizar";icon:root.icon-sync;clicked=>{root.refresh();}}
                    }
                    if root.page=="hub": HorizontalLayout {height:40px;spacing:10px;
                        Image {source:root.icon-calendar;width:21px;image-fit:contain;colorize:#A6A6B0;}
                        LineEdit {width:138px;text<=>root.selected-day;placeholder-text:"AAAA-MM-DD";accepted=>{root.filters-changed();}}
                        ComboBox {width:142px;model:["Tudo","Conversas","Tarefas","Arquivos","Android","Serviços"];current-index<=>root.kind-index;selected=>{root.filters-changed();}}
                        LineEdit {text<=>root.search-query;placeholder-text:"Pesquisar no histórico";accepted=>{root.filters-changed();}}
                        IconButton {label:"Aplicar filtros";icon:root.icon-search;clicked=>{root.filters-changed();}}
                    }
                    if root.page=="hub": Rectangle {vertical-stretch:1;background:#0B0B0D;border-width:1px;border-color:#303036;border-radius:14px;clip:true;
                        ChatViewport {events:root.events;has-more:root.has-more;chat-icon:root.icon-chat;folder-icon:root.icon-folder;
                            scroll-position<=>root.chat-scroll-y;
                            metrics(total,visible)=>{root.chat-total-height=total;root.chat-visible-height=visible;if root.follow-tail {root.scroll-to-bottom();}}
                            user-scrolled=>{root.scroll-mode=0;root.follow-tail=root.at-bottom;}
                            load-more=>{root.load-more();}open-artifact(id)=>{root.open-artifact(id);}
                        }
                        if root.events.length==0: VerticalLayout {alignment:center;spacing:12px;
                            Text {text:root.online ? "Espaço para o seu dia" : "Seu hub, sempre por perto";font-size:20px;font-weight:650;color:#FFFFFF;horizontal-alignment:center;}
                            Text {text:root.online ? "As conversas e atualizações aparecem aqui." : "Abra Ajustes para conectar seu aplicativo.";font-size:13px;color:#A6A6B0;horizontal-alignment:center;}
                        }
                    }
                    if root.page=="hub": Rectangle {height:96px;background:#17171B;border-width:1px;border-color:#303036;border-radius:14px;
                        VerticalLayout {padding:12px;spacing:7px;
                            HorizontalLayout {spacing:10px;
                                TextEdit {text<=>root.composer;placeholder-text:"Mensagem para o ZaturoBot";height:52px;wrap:word-wrap;}
                                IconButton {label:"Enviar mensagem";icon:root.icon-send;primary:true;enabled:root.composer!="" && !root.sending;clicked=>{root.send-message();}}
                            }
                            Text {text:"As solicitações ficam no histórico. Ações respeitam as permissões do computador.";font-size:10px;color:#777780;}
                        }
                    }
                    if root.page=="settings": Rectangle {vertical-stretch:1;background:#17171B;border-width:1px;border-color:#303036;border-radius:14px;
                        VerticalLayout {padding:24px;spacing:14px;alignment:start;
                            Text {text:"Conexão privada";font-size:20px;font-weight:700;color:#FFFFFF;}
                            Text {text:"Conecte seu hub por HTTPS ou pelo túnel local existente.";font-size:13px;color:#A6A6B0;wrap:word-wrap;}
                            Text {text:"Endereço do hub";font-size:12px;color:#D9D9E0;}
                            LineEdit {text<=>root.connection-url;placeholder-text:"http://127.0.0.1:17878";}
                            Text {text:"Token do aplicativo";font-size:12px;color:#D9D9E0;}
                            LineEdit {text<=>root.connection-token;placeholder-text:"Deixe vazio para manter o token atual";input-type:password;}
                            Text {text:"Computador de execução";font-size:12px;color:#D9D9E0;}
                            LineEdit {text<=>root.worker-target;}
                            FlatButton {label:"Salvar e conectar";icon:root.icon-check;primary:true;clicked=>{root.save-connection();}}
                            Text {text:"A credencial do app permanece privada neste computador.\nAs chaves administrativas e de IA não são necessárias aqui.";font-size:12px;color:#A6A6B0;wrap:word-wrap;}
                        }
                    }
                    if root.page=="workers": Rectangle {vertical-stretch:1;background:#17171B;border-width:1px;border-color:#303036;border-radius:14px;
                        VerticalLayout {padding:24px;spacing:14px;alignment:start;
                            Text {text:"Dispositivos registrados";font-size:20px;font-weight:700;color:#FFFFFF;}
                            Text {text:"O último contato não garante que o computador está conectado agora.";font-size:12px;color:#A6A6B0;wrap:word-wrap;}
                            for worker in root.workers: Rectangle {height:76px;background:#101013;border-width:1px;border-color:#303036;border-radius:12px;
                                VerticalLayout {padding:15px;spacing:8px;Text{text:worker.id;font-weight:700;color:#FFFFFF;}Text{text:worker.detail;color:#A6A6B0;font-size:12px;wrap:word-wrap;}}
                            }
                        }
                    }
                    if root.page=="services": Rectangle {vertical-stretch:1;background:#17171B;border-width:1px;border-color:#303036;border-radius:14px;
                        VerticalLayout {padding:24px;spacing:15px;alignment:start;
                            Text {text:"Ações do bot no computador selecionado";font-size:20px;font-weight:700;color:#FFFFFF;}
                            HorizontalLayout {spacing:12px;
                                FlatButton {label:"Diagnóstico";icon:root.icon-terminal;enabled:!root.sending;clicked=>{root.diagnostic();}}
                                FlatButton {label:"Perfis do YouTube";icon:root.icon-youtube;enabled:!root.sending;clicked=>{root.service-action("youtube_profiles");}}
                                FlatButton {label:"Dispositivos Android";icon:root.icon-phone;enabled:!root.sending;clicked=>{root.service-action("android_devices");}}
                            }
                            Text {text:root.services-summary;font-size:14px;color:#D9D9E0;wrap:word-wrap;}
                            Text {text:"Contas do YouTube são conectadas no computador de execução.\nDispositivos Android precisam de autorização USB e seleção explícita.";font-size:12px;color:#A6A6B0;wrap:word-wrap;}
                        }
                    }
                    if root.page=="files": Rectangle {vertical-stretch:1;background:#17171B;border-width:1px;border-color:#303036;border-radius:14px;
                        VerticalLayout {padding:24px;spacing:15px;alignment:start;
                            Text {text:"Entrega criptografada entre os computadores";font-size:20px;font-weight:700;color:#FFFFFF;}
                            Text {text:"Os arquivos recebidos ficam na caixa de entrada privada.\nA VPS transporta conteúdo cifrado; o worker verifica antes de salvar.";color:#D9D9E0;wrap:word-wrap;}
                            Text {text:"zaturo files send /caminho/arquivo --to work-pc\nzaturo files list\nzaturo files status ID";font-family:"JetBrains Mono";font-size:13px;color:#E5B900;}
                            Text {text:"Use o cliente de dispositivo instalado para enviar e receber.\nA credencial do app não substitui sua identidade de arquivos.";font-size:12px;color:#A6A6B0;wrap:word-wrap;}
                        }
                    }
                    if root.page=="private": Rectangle {vertical-stretch:1;background:#17171B;border-width:1px;border-color:#303036;border-radius:14px;
                        VerticalLayout {padding:22px;spacing:12px;
                            Text {text:"CAPTURA PRIVADA · PONTA A PONTA";color:#E5B900;font-size:11px;font-weight:700;}
                            Text {text:"Deixe o aplicativo de SMS aberto no telefone desbloqueado. A espera observa mudanças visuais; não lê nem reconhece códigos. Nenhuma imagem entra no feed, nos logs ou na IA.";color:#A6A6B0;font-size:12px;wrap:word-wrap;}
                            HorizontalLayout {spacing:10px;LineEdit {text<=>root.private-device;placeholder-text:"Dispositivo Android registrado";}LineEdit {width:130px;text<=>root.private-watch;placeholder-text:"Espera 0–120 s";}}
                            CheckBox {text:"Confirmo o acesso ao meu próprio telefone e autorizo esta captura privada.";checked<=>root.private-confirmed;}
                            HorizontalLayout {spacing:12px;FlatButton {label:"Autorizar captura";icon:root.icon-shield;primary:true;enabled:root.private-confirmed&&!root.private-running;clicked=>{root.start-private();}}FlatButton {label:"Encerrar e limpar";icon:root.icon-close;clicked=>{root.close-private();}}}
                            Text {text:root.private-status;color:#D9D9E0;font-size:12px;wrap:word-wrap;}
                            Rectangle {vertical-stretch:1;background:#08080A;border-radius:10px;border-width:1px;border-color:#303036;
                                if root.private-image-visible: Image {source:root.private-image;image-fit:contain;}
                                if !root.private-image-visible: Text {text:root.private-running ? "Aguardando o computador e o telefone…" : "A imagem aparecerá apenas nesta sessão.";color:#777780;horizontal-alignment:center;vertical-alignment:center;font-size:13px;}
                            }
                            Text {text:"A tela é apagada em até 60 segundos, ao sair desta aba ou ao tirar o foco da janela. Bloqueios do Android e janelas protegidas são respeitados.";color:#A6A6B0;font-size:11px;wrap:word-wrap;}
                        }
                    }
                    Text {text:root.status-message;font-size:11px;color:#A6A6B0;wrap:word-wrap;height:20px;}
                }
            }
        }
    }
    if root.preview-open: Rectangle {background:#09090BEF;
        VerticalLayout {padding:26px;spacing:14px;
            HorizontalLayout {Text{text:"Imagem recebida e verificada";color:#FFFFFF;horizontal-stretch:1;}FlatButton {label:"Fechar";icon:root.icon-close;clicked=>{root.preview-open=false;}}}
            Image {source:root.preview-image;image-fit:contain;}
        }
    }
}
