# Variable names and non-secret placeholders only. No automatic dotenv loading.
# Generate two distinct random tokens locally; each must be at least 32 ASCII characters.
# Hub serve needs both; owner CLI needs owner only; worker needs worker only.
ZATURO_OWNER_TOKEN=replace-with-a-locally-generated-owner-token
ZATURO_WORKER_TOKEN=replace-with-a-distinct-locally-generated-worker-token
RUST_LOG=info

# Worker only. Never copy the provider key to the hub or commit a real value.
OPENCODE_GO_API_KEY=replace-with-worker-local-provider-key

# Deployment workstation only; runtime binaries do not consume these variables.
# Store a private-key FILE PATH, never its contents. Keep the existing key protected.
ZATURO_DEPLOY_SSH_HOST=replace-with-the-confirmed-oracle-address
ZATURO_DEPLOY_SSH_USER=ubuntu
ZATURO_DEPLOY_SSH_PORT=22
ZATURO_DEPLOY_SSH_KEY=/absolute/path/to/ZaturoBot/.secrets/ssh/ssh-key-YYYY-MM-DD.key
